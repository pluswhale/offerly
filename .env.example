# Copy values into apps/web/.env.local and apps/api/.env — see RUNNING_LOCALLY.md.
# NEVER commit real env files. This file must only ever contain placeholders.

# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# API only — bypasses RLS. Used for webhooks + usage metering. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service-role...
SUPABASE_JWT_SECRET=your-jwt-secret

# --- LLM provider ---
LLM_PROVIDER_API_KEY=sk-...
# Any OpenAI-compatible chat-completions endpoint works (OpenAI, Groq, Together, vLLM…)
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MAX_CONCURRENCY=4

# --- Stripe (test mode for local dev) ---
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen` locally (whsec_...) — NOT the same as the secret key
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- App URLs ---
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
